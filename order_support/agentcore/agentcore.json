{
  "name": "OrderSupport",
  "version": 2,
  "managedBy": "CDK",
  "tags": {
    "agentcore:project-name": "OrderSupport"
  },
  "runtimes": [
    {
      "name": "concierge",
      "description": "Order-support concierge (OpenAI Agents SDK) on a scale-to-zero Temporal Worker with activity sessions",
      "build": "CodeZip",
      "entrypoint": "agentcore_worker.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "envVars": [
        { "name": "ORDER_SUPPORT_AGENT", "value": "concierge" },
        { "name": "TEMPORAL_ADDRESS", "value": "ns-agentcore-demo-001.temporal-dev.tmprl-test.cloud:7233" },
        { "name": "TEMPORAL_NAMESPACE", "value": "ns-agentcore-demo-001.temporal-dev" },
        { "name": "ORDER_SUPPORT_SECRET_ID", "value": "order-support/keys" },
        { "name": "TEMPORAL_DEPLOYMENT_NAME", "value": "order-support-concierge" },
        { "name": "TEMPORAL_BUILD_ID", "value": "1.0.0" },
        { "name": "AWS_REGION", "value": "us-west-2" },
        { "name": "AGENTCORE_DEBOUNCE_SECONDS", "value": "60" },
        { "name": "SESSION_HEARTBEAT_TABLE", "value": "agent-session-heartbeats" }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60,
        "maxLifetime": 28800
      },
      "additionalPolicies": ["secrets-policy.json", "session-heartbeat-policy.json"]
    },
